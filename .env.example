# OpenRouter API key (https://openrouter.ai/keys)
OPEN_ROUTER_API_KEY=
# Optional: model's canonical_slug from https://openrouter.ai/api/v1/models
# OPEN_ROUTER_MODEL=anthropic/claude-opus-5.5-20260921
# Optional: set to 0 to stop answers from falling back to web search
# CODBOT_WEB_SEARCH=1
# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=
# Optional: guild (server) ID to sync slash commands to instantly during development
DISCORD_GUILD_ID=
# Optional overrides
# CODBOT_KNOWLEDGE_DIR=knowledge
# Optional: where saved conversations are kept (SQLite)
# CODBOT_HISTORY_DB=data/history.sqlite3
# Optional: web server address (codbot-web)
# CODBOT_HOST=127.0.0.1
# CODBOT_PORT=8000
